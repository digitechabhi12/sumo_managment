{
  "name": "sumo_mangment",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.3",
    "@cap-js/hana": "^2",
    "@cap-js/postgres": "^2.0.5",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "crypto": "^1.0.1",
    "express": "^4",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.6"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.13.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": ">=8",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-portal": "cds watch --open portal/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy sumo_mangment --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "debug": "npx -n=\"--inspect\" cds run"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "[sqlite]": {
            "kind": "sqlite",
            "impl": "@cap-js/sqlite",
            "credentials": {
              "url": "sqlite.db"
            }
          },
          "[pg]": {
            "kind": "postgres",
             "schema_evolution": false,
            "impl": "@cap-js/postgres",
            "credentials": {
              "host": "localhost",
              "port": "54859",
              "user": "postgres",
              "password": "1234",
              "database": "MM"
            }
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked"
        },
        "[production]": {
          "kind": "mocked"
        }
      },
      "connectivity": true,
      "destinations": true,
      "html5-runtime": true,
      "cov2ap": {
        "plugin": true
      }
    }
  }
}
